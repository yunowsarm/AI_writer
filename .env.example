# ===== 服务与 MySQL：运行 npm run setup 自动生成本机 .env =====
PORT=31001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3003
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=mujian
DB_USER=mujian
DB_PASSWORD=
# ===== DeepSeek 默认服务参数：用户 Key 在个人 API 配置页面填写，不共用环境 Key =====
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_TIMEOUT_MS=180000
# ===== 首次管理员：setup 自动生成随机密码，之后通过个人中心修改 =====
ADMIN_EMAIL=admin@mujian.local
ADMIN_PASSWORD=
# ===== 微信网站应用：未配置时入口明确显示不可用 =====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK=http://127.0.0.1:3003/api/auth/wechat/callback
# ===== 邮箱验证码：注册必须验证邮箱；未配置时禁用新注册、验证码登录和找回密码 =====
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NODE_ENV=development
